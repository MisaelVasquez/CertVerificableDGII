# === OFV DGII — API de certificación "Impuestos al Día" ===
# Copia a .env y ajusta. Todo lo que empieza por OFV_/VERIFIABLY_/GRAPH_ se lee en config.py

# --- Fuente de datos del contribuyente (CSV que simula el core tributario) ---
OFV_CONTRIBUYENTES_CSV=../data/contribuyentes-impuestos-al-dia.csv

# Registro local credential_id -> correo. Se escribe al emitir (si se envió por correo)
# y se consulta al revocar/reinstalar para notificar al mismo destinatario.
OFV_RECIPIENTS_PATH=../data/credencial-correos.json

# Bitácora de auditoría por credencial (emitida/revocada/reinstalada/verificada).
OFV_AUDIT_PATH=../data/credencial-bitacora.json

# --- Backend verifiably (emisor de la credencial verificable) ---
# Debe coincidir con VERIFIABLY_PUBLIC_HOST del stack (localhost en Docker Desktop, o la IP LAN).
VERIFIABLY_BASE_URL=http://localhost:8080
# API key del stack verifiably. En el stack se configura VERIFIABLY_API_KEYS="ofv:<secret>"
# y aquí pones ese mismo <secret>.
VERIFIABLY_API_KEY=
# Cómo localizar el schema "Impuestos al Día". Si conoces el id exacto ponlo;
# si no, se resuelve por nombre contra GET /api/v1/schemas.
VERIFIABLY_SCHEMA_ID=
VERIFIABLY_SCHEMA_NAME=Certificación de Impuestos al Día
# DPG emisor (walt.id en el escenario que funciona). Vacío = el primero disponible.
VERIFIABLY_ISSUER_DPG=

# --- Entrega por correo (Microsoft Graph, app-only / client-credentials) ---
# Déjalo en false hasta tener el app registration nuevo con Mail.Send + consentimiento admin.
# En false, el correo NO se envía: la respuesta trae el offer_uri y el QR para inspección manual.
OFV_EMAIL_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Buzón emisor (UPN o id) — debe estar cubierto por la Application Access Policy del tenant.
GRAPH_SENDER=certificaciones@tudominio.onmicrosoft.com

# --- Presentación del correo ---
OFV_EMITTER_DISPLAY=Dirección General de Impuestos Internos (DGII)
OFV_EMAIL_SUBJECT=Su Certificación de Impuestos al Día (credencial verificable)
OFV_REVOCATION_SUBJECT=Su Certificación de Impuestos al Día ha sido revocada
OFV_REINSTATEMENT_SUBJECT=Su Certificación de Impuestos al Día ha sido reinstalada
